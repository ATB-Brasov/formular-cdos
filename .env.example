# Hashing — required, generate with: openssl rand -base64 32
HASH_SECRET="change-me-to-a-random-secret"
HASH_SALT="change-me-to-a-random-salt"

# Admin panel password hash — required
# Generate using: deno eval "const {hash}=await import('npm:argon2'); console.log(await hash('your-password'))"
# or use an online Argon2 generator
HASH_CONTROL='$argon2id$v=19$m=65536,t=3,p=4$...'

# API token for programmatic answer export — required
# Change from the placeholder before deploying to production
EXPORT_API_TOKEN="change-me-to-a-random-secret"

# Admin authentication — optional, defaults to true
# Set to "false" to disable auth (useful for local dev)
# ADMIN_AUTH_ENABLED="false"

# Origin URL for iframe postMessage target — optional, defaults to "*"
# Set to the parent page origin when embedding in an iframe, e.g.:
# PUBLIC_ORIGIN="https://atbbrasov.ro"

# Gmail API — optional, for sending verification emails
# Using a Google service account with domain-wide delegation:
# 1. Create a service account in Google Cloud Console (Gmail API enabled)
# 2. In Google Admin Console > Security > API controls, grant the service account
#    the https://mail.google.com/ scope for the GMAIL_USER email
# 3. Download the JSON key and use the client_email and private_key fields:
# GOOGLE_SERVICE_ACCOUNT_EMAIL="gmail-api@project.iam.gserviceaccount.com"
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# GMAIL_USER="noreply@atbbrasov.ro"
